# Public base URL used to build share links and Open Graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where wishes, stats and optimized photos are stored (local driver)
DATA_DIR=./.data

# How long a birthday wish (and its photos) stays online, in days
WISH_RETENTION_DAYS=30

# Admin area at /admin — leave ADMIN_PASSWORD empty to disable it
ADMIN_PASSWORD=change-me
SESSION_SECRET=a-long-random-string

# Bearer token for the cleanup endpoint (GET /api/cron/cleanup)
CRON_SECRET=another-long-random-string
